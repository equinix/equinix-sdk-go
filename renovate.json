{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:gomodIndirectSecurityUpdates",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "minimumReleaseAge": "3 days",
  "ignorePaths": [],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the openapi-generator image tag in the Makefile",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["OPENAPI_IMAGE_TAG=(?<currentValue>v\\S+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "openapitools/openapi-generator-cli",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Renovate does not check release age for pin updates, so a release age would block them forever",
      "matchUpdateTypes": ["pin"],
      "minimumReleaseAge": null
    }
  ]
}
